    <worksheet name='OTD % by Shipping Mode'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#555555' fontsize='10'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dataco_supply_chain_clean.csv (Multiple Connections)' name='federated.13xciln0bgebo5193fzny1tyfww8' />
          </datasources>
          <datasource-dependencies datasource='federated.13xciln0bgebo5193fzny1tyfww8'>
            <column caption='is_on_time' datatype='integer' name='[Calculation_4685871081455616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [delivery_status] = &quot;Shipping on time&quot; OR [delivery_status] = &quot;Advance shipping&quot; THEN 1 ELSE 0 END' />
            </column>
            <column caption='OTD %' datatype='real' name='[Calculation_4685871081771009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_4685871081455616]) * 100' />
